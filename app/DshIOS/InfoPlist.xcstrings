{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent look at and arrange your schedule when you ask it to. To answer your questions, the events involved are sent with the conversation to the model provider you chose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体按你的要求查看和安排日程。为回答你的问题，相关日程内容会随对话发送给你选择的模型服务商。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente consulte y organice tu agenda cuando se lo pidas. Para responder a tus preguntas, los eventos implicados se envían con la conversación al proveedor de modelos que hayas elegido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じて、エージェントがカレンダーを確認したり予定を入れたりします。質問に答えるため、関係する予定の内容は会話と一緒に、選択したモデルプロバイダへ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 일정을 확인하고 정리해요. 질문에 답하기 위해 관련 일정 내용이 대화와 함께 선택한 모델 제공업체로 전송돼요."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent look at and create reminders when you ask it to. To answer your questions, the reminders involved are sent with the conversation to the model provider you chose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体按你的要求查看和创建提醒。为回答你的问题，相关提醒内容会随对话发送给你选择的模型服务商。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente consulte y cree recordatorios cuando se lo pidas. Para responder a tus preguntas, los recordatorios implicados se envían con la conversación al proveedor de modelos que hayas elegido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じて、エージェントがリマインダーを確認したり作成したりします。質問に答えるため、関係するリマインダーの内容は会話と一緒に、選択したモデルプロバイダへ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 미리 알림을 확인하고 만들어요. 질문에 답하기 위해 관련 미리 알림 내용이 대화와 함께 선택한 모델 제공업체로 전송돼요."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos you take are sent to the agent as attachments, and the camera scans the sign-in QR code on your computer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照后作为附件发给智能体，或扫描电脑上的登录二维码。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que tomes se envían al agente como archivos adjuntos, y la cámara escanea el código QR de inicio de sesión de tu ordenador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影した写真を添付ファイルとしてエージェントに送ったり、パソコンに表示されたサインイン用QRコードを読み取ったりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "촬영한 사진을 첨부 파일로 에이전트에게 보내거나, 컴퓨터에 표시된 로그인 QR 코드를 스캔해요."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent read your position once, when you ask where you are or what is nearby. Read only when it is used, never tracked continuously. To answer your questions, the position is sent with the conversation to the model provider you chose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体在你问「我在哪」「附近有什么」时读取一次当前位置。只在用到时读，不会持续记录。为回答你的问题，位置会随对话发送给你选择的模型服务商。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente lea tu posición una sola vez, cuando preguntas dónde estás o qué hay cerca. Se lee solo cuando se usa, nunca se registra de forma continua. Para responder a tus preguntas, la posición se envía con la conversación al proveedor de modelos que hayas elegido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今どこにいる？」「近くに何がある？」と尋ねたときに、エージェントが現在地を1回だけ読み取ります。使うときだけ読み取り、継続して記録することはありません。質問に答えるため、位置情報は会話と一緒に、選択したモデルプロバイダへ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"지금 어디야?\", \"근처에 뭐가 있어?\"라고 물을 때 에이전트가 현재 위치를 한 번 읽어요. 필요할 때만 읽고 계속 기록하지 않아요. 질문에 답하기 위해 위치가 대화와 함께 선택한 모델 제공업체로 전송돼요."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent read your health data when you ask about it — steps, sleep, heart rate and so on. To answer your questions, the values it reads are sent with the conversation to the model provider you chose. The app never writes or changes any health data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体在你问起时读取你的健康数据，比如步数、睡眠、心率。为回答你的问题，读到的数值会随对话发送给你选择的模型服务商。App 不会写入或修改任何健康数据。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente lea tus datos de salud cuando preguntas por ellos: pasos, sueño, frecuencia cardíaca, etc. Para responder a tus preguntas, los valores leídos se envían con la conversación al proveedor de modelos que hayas elegido. La app nunca escribe ni modifica ningún dato de salud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋ねたときに、エージェントが歩数、睡眠、心拍数などのヘルスケアデータを読み取ります。質問に答えるため、読み取った値は会話と一緒に、選択したモデルプロバイダへ送信されます。App がヘルスケアデータを書き込んだり変更したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물어볼 때 에이전트가 걸음 수, 수면, 심박수 같은 건강 데이터를 읽어요. 질문에 답하기 위해 읽은 값이 대화와 함께 선택한 모델 제공업체로 전송돼요. 앱은 건강 데이터를 기록하거나 변경하지 않아요."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version never writes or changes any Health data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个版本不会向「健康」写入或修改任何数据。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión nunca escribe ni modifica datos de Salud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンは「ヘルスケア」にデータを書き込んだり変更したりしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전은 건강 앱에 데이터를 기록하거나 변경하지 않아요."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent read out what is said in a recording when you ask it to. Recognition stays on the phone by default and the recording does not leave it; only when server recognition is asked for explicitly is the recording sent to Apple's servers. To answer your questions, the transcript is sent with the conversation to the model provider you chose. The app does not record and does not use the microphone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体在你要求时读出录音文件里说了什么。默认只在本机识别，录音不离开手机；只有在明确指定云端识别时，录音才会发送给 Apple 的服务器。为回答你的问题，转写出的文字会随对话发送给你选择的模型服务商。App 不会录音，也不使用麦克风。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente lea lo que se dice en una grabación cuando se lo pides. El reconocimiento se hace en el teléfono por omisión y la grabación no sale de él; solo si se pide explícitamente el reconocimiento en servidor se envía la grabación a los servidores de Apple. Para responder a tus preguntas, la transcripción se envía con la conversación al proveedor de modelos que hayas elegido. La app no graba ni usa el micrófono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じて、エージェントが録音ファイルの内容を文字に起こします。認識は標準でこのデバイス上で行い、録音がデバイスの外に出ることはありません。サーバでの認識を明示的に指定した場合のみ、録音が Apple のサーバへ送信されます。質問に答えるため、書き起こしたテキストは会話と一緒に、選択したモデルプロバイダへ送信されます。App が録音したりマイクを使ったりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 녹음 파일의 내용을 받아 적어요. 기본적으로 기기에서만 인식하며 녹음은 기기 밖으로 나가지 않아요. 서버 인식을 명시적으로 지정한 경우에만 녹음이 Apple 서버로 전송돼요. 질문에 답하기 위해 받아 적은 텍스트가 대화와 함께 선택한 모델 제공업체로 전송돼요. 앱은 녹음하지 않으며 마이크도 사용하지 않아요."
          }
        }
      }
    },
    "NSHomeKitUsageDescription" : {
      "comment" : "Privacy - HomeKit Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent look at the accessories in your home and their state when you ask, and change them or run scenes the way you set under Device capabilities. To answer your questions, accessory names and states are sent with the conversation to the model provider you chose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体按你的要求查看家里的配件和它们的状态，并按你设的写入方式改状态或执行场景。为回答你的问题，配件名称和状态会随对话发送给你选择的模型服务商。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente vea los accesorios de tu casa y su estado cuando lo pides, y que los cambie o ejecute escenas según lo que configures en Funciones del dispositivo. Para responder a tus preguntas, los nombres y estados de los accesorios se envían con la conversación al proveedor de modelos que hayas elegido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じて、エージェントが家のアクセサリとその状態を確認し、「デバイス機能」で設定した書き込み方法に従って状態を変更したりシーンを実行したりします。質問に答えるため、アクセサリの名前と状態は会話と一緒に、選択したモデルプロバイダへ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 집의 액세서리와 상태를 확인하고, '기기 기능'에서 설정한 쓰기 방식에 따라 상태를 바꾸거나 장면을 실행해요. 질문에 답하기 위해 액세서리 이름과 상태가 대화와 함께 선택한 모델 제공업체로 전송돼요."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent see what is in your photo library when you ask, export pictures for the phone to read on-device, and organize your library the way you set writing under Device capabilities. To answer your questions, the information involved is sent with the conversation to the model provider you chose. iOS asks you again before any photo is deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体在你问起时查看相册里有哪些照片、导出照片给本机识别，并按你在「本机能力」里设的写入方式帮你整理相册。为回答你的问题，相关信息会随对话发送给你选择的模型服务商。删除照片前 iOS 会再问你一次。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente vea qué hay en tu fototeca cuando preguntas, exporte fotos para que el teléfono las analice en el propio dispositivo y organice tu fototeca según cómo configures la escritura en Funciones del dispositivo. Para responder a tus preguntas, la información implicada se envía con la conversación al proveedor de modelos que hayas elegido. iOS te pregunta de nuevo antes de eliminar cualquier foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋ねたときに、エージェントが写真ライブラリの内容を確認し、写真を書き出してこのデバイス上で認識し、「デバイス機能」で設定した書き込み方法に従ってライブラリを整理します。質問に答えるため、関係する情報は会話と一緒に、選択したモデルプロバイダへ送信されます。写真を削除する前に iOS がもう一度確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물어볼 때 에이전트가 사진 보관함에 어떤 사진이 있는지 확인하고, 사진을 내보내 기기에서 인식하며, '기기 기능'에서 설정한 쓰기 방식에 따라 보관함을 정리해요. 질문에 답하기 위해 관련 정보가 대화와 함께 선택한 모델 제공업체로 전송돼요. 사진을 삭제하기 전에 iOS가 한 번 더 확인해요."
          }
        }
      }
    },
    "NSAlarmKitUsageDescription" : {
      "comment" : "Privacy - AlarmKit Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent set a real alarm when you ask for one. An alarm rings through silent mode and Focus, and keeps ringing until you stop it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体按你的要求设真正的闹钟。闹钟会穿透静音和专注模式，响到你关掉为止。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente ponga una alarma real cuando se la pides. La alarma suena aunque el teléfono esté en silencio o en modo Concentración, y sigue sonando hasta que la apagues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じて、エージェントが本物のアラームを設定します。アラームは消音モードや集中モード中でも鳴り、止めるまで鳴り続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 실제 알람을 설정해요. 알람은 무음 모드와 집중 모드에서도 울리며, 끌 때까지 계속 울려요."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the agent look up a contact by name, phone number or email when you ask, for example to find someone's address before drafting an email. To answer you, the contact details it finds are sent with the conversation to the model provider you chose. The app never adds, changes or deletes a contact."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让智能体在你要求时按名字、电话或邮箱查找联系人，比如替你写邮件前查对方的地址。为回答你的问题，查到的联系人信息会随对话发送给你选择的模型服务商。App 不会添加、修改或删除任何联系人。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el agente busque un contacto por nombre, teléfono o correo cuando se lo pides, por ejemplo para encontrar la dirección de alguien antes de redactar un correo. Para responderte, los datos del contacto que encuentre se envían con la conversación al proveedor de modelos que hayas elegido. La app nunca añade, modifica ni elimina contactos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じて、エージェントが名前、電話番号、メールアドレスで連絡先を検索します。たとえばメールを書く前に相手のアドレスを調べます。質問に答えるため、見つかった連絡先情報は会話と一緒に、選択したモデルプロバイダへ送信されます。App が連絡先を追加、変更、削除することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 이름, 전화번호, 이메일로 연락처를 찾아요. 예를 들어 이메일을 쓰기 전에 상대방 주소를 찾아요. 질문에 답하기 위해 찾은 연락처 정보가 대화와 함께 선택한 모델 제공업체로 전송돼요. 앱은 연락처를 추가, 변경, 삭제하지 않아요."
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
