        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 작업을 확인할 수 없어요. 로그아웃하면 이 계정을 사용하는 작업이 중단될 수 있어요. 지금 로그아웃할까요?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
