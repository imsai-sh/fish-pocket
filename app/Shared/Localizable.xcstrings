        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간이 초과된 명령은 종료돼요. 한도를 넘는 출력은 임시 파일에 저장돼요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
