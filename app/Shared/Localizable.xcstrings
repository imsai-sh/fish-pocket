    "只保存在本机引擎里，任何读取接口都不会返回它。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored only in the on-device engine; no read API ever returns it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se guarda en el motor local; ninguna interfaz de lectura lo devuelve."
          }
