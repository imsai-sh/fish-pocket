          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 대화의 브라우저에서 로그아웃되고, 쿠키와 웹사이트 저장 공간도 함께 삭제됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
