          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは。この声で読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요, 이 목소리로 읽어 드릴게요."
          }
