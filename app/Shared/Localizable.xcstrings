    "支持深度思考和工具调用。1 积分约 %lld 个输入 Token 或 %lld 个输出 Token。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep thinking and tool calls. 1 credit ≈ %1$lld input tokens or %2$lld output tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razonamiento profundo y uso de herramientas. 1 crédito ≈ %1$lld tokens de entrada o %2$lld de salida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
