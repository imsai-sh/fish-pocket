    "认出图里的文字、二维码和内容。全在本机算，图片不上传" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the text, QR codes and contents of an image. On the device; the picture is never uploaded"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el texto, los códigos QR y el contenido de una imagen. En el dispositivo; la foto nunca se sube"
          }
        }
      }
    },
    "认语言、分词、情绪、认出人名地名。全在本机算，不出手机" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifies the language, splits text up, scores sentiment, finds names and places. All on the device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica el idioma, divide el texto, puntúa el sentimiento y encuentra nombres y lugares. Todo en el dispositivo"
          }
        }
      }
    },
    "认语言、认出人名地名、按意思给一堆文字排序。全在本机算，不出手机" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifies languages, finds names and places, and sorts text by meaning. On the device; nothing leaves the phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifica idiomas, encuentra nombres y lugares y ordena textos por significado. En el dispositivo; nada sale del teléfono"
          }
        }
      }
    },
