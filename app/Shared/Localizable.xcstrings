    "以下包带安装脚本，默认不运行。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These packages have install scripts, which don’t run by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos paquetes tienen scripts de instalación, que no se ejecutan de forma predeterminada."
