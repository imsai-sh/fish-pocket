    "主 Bot 不能删除，先取消它的主 Bot 身份" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Main Bot cannot be deleted. Remove its Main Bot role first"
