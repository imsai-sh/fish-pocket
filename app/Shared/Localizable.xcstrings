    "取消失败：这条消息可能已经开始发送。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't cancel: this message may already be on its way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cancelar: es posible que este mensaje ya se esté enviando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消せませんでした。このメッセージはすでに送信中の可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소하지 못했어요. 이 메시지가 이미 전송 중일 수 있어요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
