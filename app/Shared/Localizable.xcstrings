            "value" : "The host first asks you a few key questions, then splits the work into stages and hands them to members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El anfitrión primero te hace algunas preguntas clave; después divide el trabajo en fases y lo reparte entre los miembros."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
