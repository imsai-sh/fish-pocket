    "%@@%@ 与 DSH %@ 不兼容（要求 %@），运行它可能导致崩溃或数据丢失。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@ is incompatible with DSH %3$@ (requires %4$@); running it may cause crashes or data loss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@ es incompatible con DSH %3$@ (requiere %4$@); ejecutarlo puede causar fallas o pérdida de datos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@ は DSH %3$@ と互換性がありません（%4$@ が必要）。実行するとクラッシュやデータ消失が起きる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@은(는) DSH %3$@과(와) 호환되지 않아요(%4$@ 필요). 실행하면 충돌이나 데이터 손실이 발생할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@ 与 DSH %3$@ 不兼容（要求 %4$@），运行它可能导致崩溃或数据丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@ 與 DSH %3$@ 不相容（需要 %4$@），執行它可能導致當機或資料遺失。"
          }
        }
      }
