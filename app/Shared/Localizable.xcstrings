        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los índices los proporcionan terceros. Agrega solo fuentes en las que confíes: los complementos instalados desde ellas se ejecutan con tus permisos"
          }
        }
      }
    },
