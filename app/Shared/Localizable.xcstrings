          }
        }
      }
    },
    "启用于" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabled in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitado en"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効な場所"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화된 곳"
          }
        }
      }
    },
    "启用后，智能体将减少确认步骤，并且可以直接执行更多操作，包括敏感操作、文件修改或外部命令。仅建议在你信任当前任务时使用。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once enabled, the agent reduces confirmation steps and can perform more actions directly, including sensitive operations, file changes, or external commands. Only use it when you trust the current task."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez habilitado, el agente reduce los pasos de confirmación y puede realizar más acciones directamente, incluidas operaciones sensibles, modificaciones de archivos o comandos externos. Úsalo solo cuando confíes en la tarea actual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、エージェントは確認の手順を減らし、機密性の高い操作、ファイルの変更、外部コマンドなど、より多くの操作を直接実行できるようになります。現在のタスクを信頼できる場合にのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 에이전트가 확인 단계를 줄이고 민감한 작업, 파일 변경, 외부 명령 등 더 많은 작업을 바로 실행할 수 있어요. 현재 작업을 신뢰할 때만 사용하세요."
          }
        }
      }
    },
