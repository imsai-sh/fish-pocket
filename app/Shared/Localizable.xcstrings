            "state" : "translated",
            "value" : "Once allowed, the scripts run on this device with your permissions and you won’t be asked again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez permitido, los scripts se ejecutan en este dispositivo con tus permisos y no se volverá a preguntar."
