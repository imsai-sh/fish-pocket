        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上のエンジンにのみ保存され、どの読み取り API からも返されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
