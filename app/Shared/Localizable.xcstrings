          "stringUnit" : {
            "state" : "translated",
            "value" : "El navegador de todas las conversaciones cerrará sesión y se borrarán las cookies y el almacenamiento de los sitios web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
