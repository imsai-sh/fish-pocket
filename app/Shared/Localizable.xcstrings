          }
        }
      }
    },
    "每张图另存一份到当前会话工作区的这个文件夹，留空存在工作区根目录。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each image is also saved to this folder in the session's workspace; leave it empty for the workspace root."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagen también se guarda en esta carpeta del espacio de trabajo de la sesión; déjalo vacío para usar la raíz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像ごとに現在のセッションのワークスペースのこのフォルダにも保存します。空欄ならワークスペースの直下に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
