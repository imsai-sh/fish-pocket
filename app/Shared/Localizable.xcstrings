          }
        }
      }
    },
    "只在信任这些包时允许。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow only packages you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite solo paquetes en los que confíes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できるパッケージの場合のみ許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰하는 패키지만 허용하세요."
          }
        }
      }
    },
    "只支持 HTTP 和 HTTPS 地址；本地文件请使用文档预览。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only HTTP and HTTPS addresses are supported; use Document Preview for local files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se admiten direcciones HTTP y HTTPS; para archivos locales, usa la vista previa de documentos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP と HTTPS のアドレスのみ対応しています。ローカルファイルには書類プレビューを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
