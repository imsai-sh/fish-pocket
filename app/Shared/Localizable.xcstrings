          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fish Pocket revisó este complemento y encontró un problema. Se retiró del mercado de complementos y ya no se puede instalar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fish Pocket の審査でこのプラグインに問題が見つかったため、プラグインマーケットから取り下げました。インストールできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fish Pocket 검토 결과 이 플러그인에 문제가 있어 플러그인 마켓에서 내려갔어요. 더 이상 설치할 수 없어요."
          }
