    "问一个旁支问题：%@会根据目前的对话回答，不动手做事，也不会写进聊天记录。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask a side question: %@ answers from the conversation so far, without taking any actions or adding to the chat history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pregunta lateral: %@ responde según la conversación actual, sin hacer nada ni añadirla al historial del chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょっと別の質問：%@はこれまでの会話をもとに回答します。操作は行わず、チャット履歴にも残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곁가지 질문하기: %@이(가) 지금까지의 대화를 바탕으로 답해요. 작업은 하지 않으며 대화 기록에도 남지 않아요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問一個旁支問題：%@會根據目前的對話回答，不動手做事，也不會寫進聊天記錄。"
          }
        }
      }
    },
    "问到的时候读一次当前位置。不持续记录，也没有轨迹" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your position once when asked. No continuous tracking and no history"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee tu posición una vez cuando se le pide. Sin seguimiento continuo ni historial"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋ねられたときに現在地を 1 回だけ読み取ります。継続的な記録や履歴はありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청할 때 현재 위치를 한 번만 읽어요. 계속 기록하지 않고 이동 경로도 남지 않아요"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問到的時候讀一次目前位置。不持續記錄，也沒有軌跡"
          }
        }
      }
    },
    "问它记得什么，或者让它记住、忘掉什么" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask what it remembers, or tell it to remember or forget something"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale qué recuerda o pídele que recuerde u olvide algo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何を覚えているか聞いたり、何かを覚えさせたり忘れさせたりできます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 기억하는지 묻거나, 기억하거나 잊게 할 수 있어요"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問它記得什麼，或者讓它記住、忘掉什麼"
          }
        }
      }
    },
