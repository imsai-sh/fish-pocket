        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiarlo, iOS muestra un aviso una vez. El icono del Apple Watch no cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更すると、iOS が一度だけお知らせを表示します。Apple Watch のアイコンは変わりません。"
