        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalé el complemento «%@» pero no lo encuentro ni sé cómo usarlo. Dime dónde está y cómo se usa. Si no funciona, averigua por qué."
