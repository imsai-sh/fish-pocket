          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャネルごとにエンドポイント、Key、モデルを設定します。会話の中でどのチャネルを使うか指定できます。"
          }
        },
        "ko" : {
