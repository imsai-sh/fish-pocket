        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los adjuntos que no son imágenes solo conservan el nombre y el tamaño. No se pueden abrir y el modelo no puede leerlos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
