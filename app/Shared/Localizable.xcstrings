        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza DSH con la conversación: deja que el agente escriba complementos que agreguen herramientas nuevas o conecten servicios externos; también puedes combinar herramientas y prompts para crear tus propios modos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
