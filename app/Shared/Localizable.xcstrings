            "value" : "화면 아래쪽에 있어요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在螢幕底部。"
          }
        }
      }
    },
    "在手腕上看会话、做确认" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions and approvals on your wrist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiones y aprobaciones en la muñeca"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首でセッションの確認と承認"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손목에서 세션 확인과 승인"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手腕上看對話、做確認"
