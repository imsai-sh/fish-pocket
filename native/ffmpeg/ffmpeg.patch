diff -ruN a/fftools/ffmpeg.c b/fftools/ffmpeg.c
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -147,16 +147,20 @@
 static void
 sigterm_handler(int sig)
 {
+#ifndef DSH_EMBEDDED
     int ret;
+#endif
     received_sigterm = sig;
     received_nb_signals++;
     term_exit_sigsafe();
+#ifndef DSH_EMBEDDED
     if(received_nb_signals > 3) {
         ret = write(2/*STDERR_FILENO*/, "Received > 3 system signals, hard exiting\n",
                     strlen("Received > 3 system signals, hard exiting\n"));
         if (ret < 0) { /* Do nothing */ };
         exit(123);
     }
+#endif
 }
 
 #if HAVE_SETCONSOLECTRLHANDLER
@@ -204,6 +208,7 @@
 
 void term_init(void)
 {
+#ifndef DSH_EMBEDDED
 #if defined __linux__
     struct sigaction action = {0};
     action.sa_handler = sigterm_handler;
@@ -248,12 +253,13 @@
 #if HAVE_SETCONSOLECTRLHANDLER
     SetConsoleCtrlHandler((PHANDLER_ROUTINE) CtrlHandler, TRUE);
 #endif
+#endif /* DSH_EMBEDDED */
 }
 
 /* read a key without blocking */
 static int read_key(void)
 {
-#if HAVE_TERMIOS_H
+#if HAVE_TERMIOS_H && !defined(DSH_EMBEDDED)
     int n = 1;
     struct timeval tv;
     fd_set rfds;
@@ -977,6 +983,16 @@
     return 0;
 #endif
 }
+
+#ifdef DSH_EMBEDDED
+/* Fish Pocket runs ffmpeg on a thread of the app: no signal reaches it, the
+ * host asks it to stop through here instead (native/ffmpeg). */
+void dsh_ffmpeg_signal(int sig)
+{
+    sigterm_handler(sig);
+}
+#define main dsh_ffmpeg_main
+#endif
 
 int main(int argc, char **argv)
 {
